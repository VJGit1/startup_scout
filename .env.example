# Google Gemini API Key (Used by LangGraph Agents & Google Search Grounding)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional path override for the configurable Founder Profile.
# Relative paths are resolved from the repository root.
FOUNDER_PROFILE_PATH=config/founder_profile.yaml

# FastAPI Server Host & Port (Called by n8n HTTP Request nodes)
HOST=0.0.0.0
PORT=8000

# When set, /api/* requires the matching X-API-Key header. Leave blank for local use.
API_AUTH_KEY=

# Public base URL used by the n8n workflows (no trailing slash), for example http://localhost:8000
PIPELINE_BASE_URL=http://localhost:8000
